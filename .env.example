# =============================================================================
# Gestly — modèle de variables d'environnement (DÉVELOPPEMENT ISOLÉ)
# =============================================================================
# Copier ce fichier en `.env.local` (lu par Next.js) ET en `.env` (lu par la
# CLI Prisma via prisma.config.ts, qui ne lit PAS .env.local), puis remplacer
# les valeurs fictives par des valeurs de DÉVELOPPEMENT.
#
# Règles :
# - Aucune valeur de production ne doit jamais figurer dans un fichier local
#   de développement. Les secrets de production vivent uniquement dans
#   Vercel (environnement Production).
# - Toutes les valeurs ci-dessous sont fictives et non fonctionnelles.
# - Une variable laissée VIDE désactive le service correspondant (voir
#   commentaires) : c'est le mode de simulation par défaut recommandé.
# =============================================================================

# --- Base de données (PostgreSQL de DÉVELOPPEMENT uniquement) ---------------
# Jamais l'URL de la base de production. lib/prisma.ts impose une connexion
# SSL : utiliser un hébergeur qui la fournit (ex. projet Supabase de dev).
DATABASE_URL="postgresql://gestly_dev:CHANGE_ME@db.example-dev-project.invalid:5432/postgres"

# --- Authentification Clerk (instance de DÉVELOPPEMENT : clés pk_test_/sk_test_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
CLERK_SECRET_KEY="sk_test_REPLACE_ME"

# --- Stripe (MODE TEST uniquement : clés sk_test_, prix créé en mode test) ---
# Secret de webhook local : fourni par `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"
STRIPE_PRICE_ID="price_REPLACE_ME"

# --- Emails Resend -----------------------------------------------------------
# VIDE en développement : aucun envoi. Attention, les routes d'envoi
# (devis/factures/health/ovh-balance) échouent alors en erreur au lieu de
# simuler. Les relances (lib/relances/engine.ts) ignorent simplement l'email.
# Si un test d'envoi est nécessaire : clé d'un compte Resend de test et
# destinataires *@resend.dev uniquement.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Gestly Dev <onboarding@resend.dev>"

# --- SMS OVH -----------------------------------------------------------------
# VIDE en développement : sendSMS() journalise "missing environment variables"
# et renvoie false. OVH n'a pas de mode test : toute clé valide envoie de
# vrais SMS facturés.
OVH_APP_KEY=""
OVH_APP_SECRET=""
OVH_CONSUMER_KEY=""
OVH_SMS_SERVICE_NAME=""
OVH_SMS_SENDER=""

# --- WhatsApp Cloud API (Meta) ----------------------------------------------
# VIDE en développement. Pour simuler : pointer WHATSAPP_GRAPH_API_BASE_URL
# vers un faux serveur local. ATTENTION : la route
# app/api/devis/[id]/whatsapp/route.ts ignore cette variable (URL Meta en dur).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET="dev-only-fake-app-secret"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="dev-only-fake-verify-token"
WHATSAPP_GRAPH_API_BASE_URL="http://127.0.0.1:4010"

# --- IA (Vercel AI Gateway ou OpenAI) ----------------------------------------
# VIDES en développement : isAiConfigured() renvoie false et aucune requête IA
# n'est envoyée. Les tests injectent des modèles simulés (ai/test).
# Ne jamais laisser de VERCEL_OIDC_TOKEN (ajouté par `vercel env pull`) : il
# peut authentifier l'AI Gateway et déclencher des appels facturés.
AI_GATEWAY_API_KEY=""
OPENAI_API_KEY=""
WHATSAPP_AI_MODEL=""
WHATSAPP_TRANSCRIPTION_MODEL=""
WHATSAPP_AI_MONTHLY_LIMIT="20"

# --- Stockage des logos (Supabase Storage) -----------------------------------
# VIDES : l'upload de logo répond "Upload non configuré". Sinon, uniquement le
# projet Supabase de développement.
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Mode des envois (lib/outbound/mode.ts) ----------------------------------
# VIDE en local : simulation. Production Vercel : "simulate" pendant la bêta
# privée (envois refusés avec un message explicite), "live" à l'ouverture
# commerciale (décision de l'utilisateur uniquement).
OUTBOUND_MODE=""

# --- Divers ------------------------------------------------------------------
CRON_SECRET="dev-only-fake-cron-secret"
# lib/url.ts rejette localhost et retombe sur https://www.gestly.fr : en
# développement, les liens publics générés pointent vers la production.
APP_URL="http://localhost:3000"

# --- Sentry (VIDES en développement : aucun envoi d'erreurs ni upload) -------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# --- Télémétrie des outils (recommandé) --------------------------------------
NEXT_TELEMETRY_DISABLED="1"
CHECKPOINT_DISABLE="1"
