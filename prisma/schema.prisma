// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String    @id @default(cuid())
  clerkId              String    @unique
  email                String
  companyName          String
  siret                String?
  address              String?
  phone                String?
  logoUrl              String?
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  subscriptionStatus      String    @default("trialing")
  trialEndsAt             DateTime  @default(dbgenerated("NOW() + INTERVAL '14 days'"))
  stripeCurrentPeriodEnd  DateTime?
  stripeCancelAtPeriodEnd Boolean   @default(false)
  plan                    String    @default("starter")
  createdAt            DateTime  @default(now())

  clients               Client[]
  devis                 Devis[]
  factures              Facture[]
  avoirs                Avoir[]
  settings              Settings?
  relanceSettings       RelanceSettings?
  relanceDevisSettings  RelanceDevisSettings?
  events                Event[]
  notifications         Notification[]
  opportunities         Opportunity[]
  whatsappConversations WhatsappConversation[]
  aiUsageEvents         AiUsageEvent[]
  documentNumberCounters DocumentNumberCounter[]
}

model Client {
  id               String   @id @default(cuid())
  userId           String
  name             String
  email            String?
  phone            String?
  address          String?
  preferredContact String   @default("email")
  // Opposition explicite du client final à recevoir des messages WhatsApp de
  // la part de cet artisan via Gestly (mot-clé STOP reçu sur ce numéro).
  // Distinct de l'opt-out de l'artisan sur le bot (WhatsappConversation.optedOut).
  whatsappOptOut   Boolean  @default(false)
  createdAt        DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  devis         Devis[]
  factures      Facture[]
  avoirs        Avoir[]
  events        Event[]
  opportunities Opportunity[]
}

model Devis {
  id           String    @id @default(cuid())
  userId       String
  clientId     String
  number       String
  status       String    @default("brouillon")
  totalHT      Float     @default(0)
  totalTVA     Float     @default(0)
  totalTTC     Float     @default(0)
  validityDays Int       @default(30)
  notes        String?
  createdAt    DateTime  @default(now())
  sentAt       DateTime?
  signedAt     DateTime?

  // Lien public de partage (§ Phase 3.3) : le devis reste identifié par son id,
  // mais l'accès public (non-propriétaire) peut être révoqué ou expirer.
  // Le propriétaire authentifié n'est jamais bloqué par ces champs.
  linkExpiresAt DateTime?
  linkRevoked   Boolean   @default(false)

  // Signature électronique simple (client, via le lien public) : consentement
  // explicite + preuve. Distinct du changement de statut manuel par l'artisan
  // (qui reste possible pour les cas signés hors-ligne, sans ces champs).
  signatureName      String?
  signatureIp        String?
  signatureUserAgent String?
  signatureHash      String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lines        DevisLine[]
  factures     Facture[]
  relances     RelanceDevis[]
  whatsappSend WhatsappSend?

  // Migration 20261022_unique_document_numbers (proposée, non appliquée).
  @@unique([userId, number])
}

model DevisLine {
  id          String @id @default(cuid())
  devisId     String
  description String
  quantity    Float
  unitPriceHT Float
  tvaRate     Float  @default(20)
  totalHT     Float

  devis Devis @relation(fields: [devisId], references: [id], onDelete: Cascade)
}

model Facture {
  id        String    @id @default(cuid())
  userId    String
  clientId  String
  devisId   String?
  number    String
  totalHT   Float
  totalTVA  Float
  totalTTC  Float
  status    String    @default("emise")
  notes     String?
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  paidAt    DateTime?
  sentAt    DateTime?

  // Document comptable à conserver : jamais supprimé en cascade avec son
  // client ni avec le compte (migration 20261022_restrict_accounting_document_deletion,
  // proposée, non appliquée).
  user     User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  client   Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  devis    Devis?        @relation(fields: [devisId], references: [id], onDelete: SetNull)
  lines    FactureLine[]
  avoirs   Avoir[]
  relances Relance[]

  // Migration 20261022_unique_document_numbers (proposée, non appliquée).
  @@unique([userId, number])
}

model FactureLine {
  id          String  @id @default(cuid())
  factureId   String
  description String
  quantity    Float
  unitPriceHT Float
  tvaRate     Float   @default(20)
  totalHT     Float

  facture Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)
}

model Settings {
  id                    String   @id @default(cuid())
  userId                String   @unique

  // Section 1 — Informations entreprise
  companyName           String   @default("")
  formeJuridique        String?
  siret                 String?
  tvaIntracom           String?
  adresseRue            String?
  codePostal            String?
  ville                 String?
  telephone             String?
  emailPro              String?
  siteWeb               String?

  // Section 2 — Apparence
  logoUrl               String?
  couleurPrincipale     String   @default("#2563EB")
  piedDePage            String?

  // Section 3 — Numérotation
  prefixeDevis          String   @default("DEV-")
  prefixeFacture        String   @default("FAC-")
  prochainNumeroDevis   Int      @default(1)
  prochainNumeroFacture Int      @default(1)

  // Section 4 — Mentions légales
  conditionsPaiement    String?
  penalitesRetard       String?
  reservePropriete      Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OvhBalanceAlert {
  id          String   @id @default(cuid())
  creditsLeft Int
  threshold   Int
  alertSentAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

// ── Avoirs (notes de crédit) ────────────────────────────────
// Une facture émise n'est jamais modifiée ni supprimée (conforme au droit
// français) : toute correction passe par un avoir référençant la facture
// d'origine, total ou partiel.
model Avoir {
  id        String   @id @default(cuid())
  userId    String
  factureId String
  clientId  String
  number    String
  type      String   @default("total") // "total" | "partiel"
  reason    String
  totalHT   Float
  totalTVA  Float
  totalTTC  Float
  createdAt DateTime @default(now())

  // Document comptable à conserver (migration
  // 20261022_restrict_accounting_document_deletion, proposée, non appliquée).
  user    User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  facture Facture     @relation(fields: [factureId], references: [id], onDelete: Restrict)
  client  Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lines   AvoirLine[]

  // Migration 20261022_unique_document_numbers (proposée, non appliquée).
  @@unique([userId, number])
}

// Compteurs de numérotation : prochain numéro par (artisan, type, série).
// Garantit qu'un numéro attribué n'est jamais réattribué, même après
// suppression du document, et porte « Prochain n° » d'une série annuelle.
// Cf. lib/numbering/document-number.ts. Migration
// 20261023_document_number_counters (proposée, non appliquée) : tant que la
// table n'existe pas, le code détecte son absence et ne l'utilise pas.
model DocumentNumberCounter {
  id        String   @id @default(cuid())
  userId    String
  kind      String // "devis" | "facture" | "avoir"
  series    String // préfixe complet de la série, ex. "DEV-2026-" ou "F2026-"
  nextValue Int
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, series])
}

model AvoirLine {
  id          String @id @default(cuid())
  avoirId     String
  description String
  quantity    Float
  unitPriceHT Float
  tvaRate     Float  @default(20)
  totalHT     Float

  avoir Avoir @relation(fields: [avoirId], references: [id], onDelete: Cascade)
}

// ── Relances automatiques de factures ───────────────────────
model RelanceSettings {
  id         String   @id @default(cuid())
  userId     String   @unique
  enabled    Boolean  @default(false)
  delaiJ1    Int      @default(3)
  delaiJ2    Int      @default(10)
  delaiJ3    Int      @default(21)
  canalEmail Boolean  @default(true)
  canalSms   Boolean  @default(false)
  messageJ1  String?
  messageJ2  String?
  messageJ3  String?
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Relance {
  id        String   @id @default(cuid())
  factureId String
  niveau    Int
  canal     String // "email" | "sms"
  statut    String // "envoyee" | "echec"
  erreur    String?
  attempts  Int      @default(1)
  envoyeeAt DateTime @default(now())

  facture Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)

  @@unique([factureId, niveau, canal])
}

// ── Relances commerciales sur devis sans réponse ────────────
// Moteur, paramètres et historique volontairement distincts des relances
// factures ci-dessus (cahier des charges initial : les deux doivent rester
// séparés même s'ils partagent le même cron). Un devis quitte la cible du
// moteur dès que son statut n'est plus "envoye" (signé, refusé, facturé,
// repassé en brouillon) ou que son lien a expiré/été révoqué.
model RelanceDevisSettings {
  id         String   @id @default(cuid())
  userId     String   @unique
  enabled    Boolean  @default(false)
  delaiJ1    Int      @default(3)
  delaiJ2    Int      @default(7)
  delaiJ3    Int      @default(14)
  canalEmail Boolean  @default(true)
  canalSms   Boolean  @default(false)
  messageJ1  String?
  messageJ2  String?
  messageJ3  String?
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RelanceDevis {
  id        String   @id @default(cuid())
  devisId   String
  niveau    Int
  canal     String // "email" | "sms"
  statut    String // "envoyee" | "echec"
  erreur    String?
  attempts  Int      @default(1)
  envoyeeAt DateTime @default(now())

  devis Devis @relation(fields: [devisId], references: [id], onDelete: Cascade)

  @@unique([devisId, niveau, canal])
}

// ── Agenda ───────────────────────────────────────────────────
model Event {
  id                    String    @id @default(cuid())
  userId                String
  clientId              String?
  title                 String
  description           String?
  address               String?
  startAt               DateTime
  endAt                 DateTime?
  reminderMinutesBefore Int?
  createdAt             DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([userId, startAt])
}

// ── Notifications internes ──────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Étape 8bis — unicité anti-doublon EN CONCURRENCE pour createNotificationOnce
  // (lib/notifications.ts), garantie au niveau base de données plutôt que par
  // la seule convention applicative (findFirst puis create n'est pas atomique
  // et pouvait produire un doublon sous course concurrente). Renseigné
  // UNIQUEMENT par createNotificationOnce (= `${type}:${link}`), toujours
  // null pour createNotification — notamment les notifications "relance_*"
  // (lib/relances/engine.ts), qui réutilisent légitimement le même (userId,
  // type, link) à chaque niveau de relance et ne doivent JAMAIS être
  // contraintes par cette unicité. L'index unique réel est un index PARTIEL
  // (WHERE "dedupeKey" IS NOT NULL) créé en SQL brut — non représentable par
  // @@unique dans ce schéma Prisma — cf.
  // prisma/manual-migrations/20260915_step8bis_notification_dedupe_up.sql.
  dedupeKey String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ── Pipeline commercial CRM (opportunités) ──────────────────
// Distinct du Kanban de suivi des devis : une opportunité peut exister avant
// même qu'un devis soit rédigé.
model Opportunity {
  id              String    @id @default(cuid())
  userId          String
  clientId        String?
  title           String
  amount          Float?
  probability     Int       @default(50)
  stage           String    @default("nouveau") // nouveau, qualification, proposition, negociation, gagne, perdu
  expectedCloseAt DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([userId, stage])
}

// ── Agent IA WhatsApp ────────────────────────────────────────
// V1 : un seul numéro Gestly partagé entre artisans. userId reste nullable
// tant que l'expéditeur n'a pas été identifié (numéro inconnu) — la
// conversation n'est jamais utilisée pour agir tant que userId est vide.
// Architecture pensée pour supporter plus tard des numéros dédiés par
// artisan sans changer ce modèle (il suffira d'ajouter la résolution du
// canal par phone_number_id Meta en amont, cf. lib/whatsapp/channel.ts).
model WhatsappConversation {
  id            String    @id @default(cuid())
  userId        String?
  phoneNumber   String // numéro E.164 de l'expéditeur (l'artisan)
  // idle | collecting | awaiting_creation_confirmation | creating |
  // awaiting_send_confirmation | sending | opted_out
  // "creating" et "sending" sont des états transitoires réclamés
  // atomiquement (cf. lib/whatsapp/confirm-creation.ts et
  // lib/whatsapp/send-devis.ts) pour garantir qu'une confirmation ne
  // produit jamais deux créations/envois, même en cas de concurrence ou de
  // retry.
  state           String    @default("idle")
  pendingDevis    Json? // brouillon structuré en cours de collecte/validation
  // Devis réellement créé pour cette conversation, une fois la création
  // confirmée (étape 5) — permet de répondre de façon idempotente à toute
  // relecture/rejeu sans jamais recréer de devis.
  lastCreatedDevisId String?
  optedOut      Boolean   @default(false) // STOP de l'artisan envers le bot
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  // Sert à détecter un état "creating" resté bloqué (crash pendant la
  // création) : reprenable seulement après un délai, jamais immédiatement
  // — sinon l'état transitoire lui-même deviendrait une brèche dans
  // l'exclusion mutuelle entre deux tentatives concurrentes.
  updatedAt     DateTime  @updatedAt

  user     User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages WhatsappMessage[]
  sends    WhatsappSend[]

  @@index([phoneNumber])
  @@index([userId])
}

model WhatsappMessage {
  id             String   @id @default(cuid())
  conversationId String
  direction      String // "in" | "out"
  type           String // "text" | "audio" | "document"
  externalId     String?  @unique // wamid Meta — garantit le dédoublonnage
  content        String   @db.Text
  createdAt      DateTime @default(now())

  // ── Champs dédiés aux messages vocaux (type="audio") ──────────────────
  // Volontairement séparés de `content` plutôt que d'y encoder plusieurs
  // informations sous forme de texte ambigu (ex. "[audio:ID]").
  mediaId             String? // identifiant média Meta, avant téléchargement
  mimeType            String? // type MIME réel constaté au téléchargement
  durationSeconds     Int? // durée audio arrondie, si fournie par le STT
  transcription       String? @db.Text
  // pending | done | failed — uniquement pertinent pour type="audio".
  // "pending" = pas encore transcrit ; permet de savoir sur un retry si la
  // transcription a déjà réussi (jamais rappeler l'API dans ce cas).
  transcriptionStatus String?
  transcriptionModel  String? // modèle utilisé — pour mesurer coûts/usage réels
  transcriptionMs     Int? // temps de traitement de la transcription (ms)

  // ── Checkpoint d'extraction IA (étape 8bis — idempotence) ─────────────
  // Même principe que transcriptionStatus, pour le même besoin : ne jamais
  // rappeler le modèle une seconde fois pour CE message si un résultat
  // valide a déjà été obtenu, y compris quand un retry de job intervient
  // APRÈS l'extraction (ex. l'envoi de la réponse WhatsApp échoue). null =
  // pas encore tenté, "processing" = réclamé atomiquement par un worker,
  // "done" = résultat validé disponible dans extractionResult. Pas d'état
  // "failed" persistant ici (contrairement à transcriptionStatus) : un
  // échec d'extraction n'est jamais définitif de ce point de vue (aucun cas
  // "ça ne marchera jamais" comme pour l'audio), donc on revient simplement
  // à null pour permettre un nouvel essai, au lieu de garder un état mort.
  extractionStatus String?
  // Résultat structuré validé (RawExtraction, cf. lib/whatsapp/pending-devis.ts)
  // — jamais le texte brut renvoyé par le modèle, uniquement les champs
  // déjà validés par le schéma Zod. Suffisant pour rejouer déterministement
  // la suite du pipeline (fusion du brouillon, confirmation...) sans jamais
  // raccéder au fournisseur IA pour ce message.
  extractionResult Json?
  extractionModel  String? // modèle utilisé — même esprit que transcriptionModel

  // Nécessaire pour détecter un claim "processing" resté bloqué (crash
  // pendant l'appel modèle) — même pattern que WhatsappJob/WhatsappConversation/
  // WhatsappSend, absent jusqu'ici de ce modèle car non nécessaire avant.
  updatedAt DateTime @updatedAt

  conversation  WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  job           WhatsappJob?
  aiUsageEvents AiUsageEvent[]
}

// File d'attente légère pour le traitement en arrière-plan (transcription,
// IA, PDF, envoi) : le webhook répond à Meta en quelques centaines de ms et
// planifie ce job ; un cron de secours reprend les jobs bloqués ou en échec.
// Pas de file externe (Redis/BullMQ) pour la V1 — volume trop faible pour le
// justifier, ce pattern cron+statut est déjà celui des relances.
model WhatsappJob {
  id        String   @id @default(cuid())
  messageId String   @unique
  status    String   @default("pending") // pending | processing | done | failed
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  message WhatsappMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Suivi dédié et persistant de l'opération d'envoi WhatsApp d'un devis au
// client final — distinct de Devis.status, qui ne suffit pas à lui seul :
// l'appel Meta est un effet de bord EXTERNE à Postgres, qu'aucune
// transaction locale ne peut annuler. Ce modèle est la seule source de
// vérité sur "a-t-on déjà contacté Meta pour ce devis, et avec quel
// résultat" — c'est ce qui permet de savoir, après un crash ou un retry,
// si un message a déjà été accepté (externalMessageId renseigné) sans
// jamais avoir à renvoyer le document une seconde fois.
//
// devisId est @unique : un seul WhatsappSend par devis pour toute la durée
// de vie de l'application — la contrainte d'unicité de la base est la
// dernière ligne de défense contre un double envoi, même en cas de bug
// applicatif dans la logique de réclamation.
model WhatsappSend {
  id                String   @id @default(cuid())
  devisId           String   @unique
  conversationId    String
  status            String   @default("pending") // pending | processing | success | failed
  attempts          Int      @default(0)
  // wamid Meta — preuve d'envoi. Renseigné UNIQUEMENT après confirmation
  // explicite de Meta, jamais avant. @unique en plus du dédoublonnage
  // applicatif : deux WhatsappSend ne peuvent jamais partager le même wamid.
  externalMessageId String?  @unique
  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  devis        Devis                @relation(fields: [devisId], references: [id], onDelete: Cascade)
  conversation WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Étape 8 — comptage brut de chaque appel IA réellement effectué (extraction
// texte WhatsApp ou transcription vocale), un événement par appel réseau
// réel au fournisseur (pas par message/tour de conversation). Sert de socle
// à un plafond configurable (cf. lib/ai/usage.ts) — jamais une offre
// commerciale figée ici, seulement des données brutes agrégables par
// utilisateur et par mois. Jamais de contenu (texte, transcript) stocké ici,
// uniquement des métadonnées numériques.
model AiUsageEvent {
  id           String   @id @default(cuid())
  userId       String
  kind         String // "extraction" | "transcription"
  success      Boolean
  inputTokens  Int?
  outputTokens Int?
  audioSeconds Int?
  createdAt    DateTime @default(now())

  // Association explicite (étape 8bis) entre l'événement d'usage et le
  // WhatsappMessage entrant qui l'a déclenché — nullable (un événement n'est
  // pas toujours rattachable à un message précis) et SetNull à la
  // suppression : un événement d'usage est une trace d'audit/coût réel, elle
  // ne doit jamais disparaître si son message source est supprimé.
  // Volontairement PAS de contrainte d'unicité (messageId, kind) : un même
  // message peut légitimement produire plusieurs événements réels pour un
  // seul appel logique (ex. un essai échoué suivi d'un essai réussi, cf.
  // MAX_ATTEMPTS dans lib/whatsapp/extraction.ts) — l'idempotence contre les
  // retries de JOB (aucun réappel du modèle une fois le résultat obtenu) est
  // garantie en amont par le claim atomique sur WhatsappMessage.extractionStatus
  // (lib/whatsapp/extraction-checkpoint.ts), pas par une contrainte ici.
  messageId String?
  message   WhatsappMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([messageId])
}
